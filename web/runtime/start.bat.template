@echo off
rem ============================================================================
rem  艺数智策 · 前端服务启动（Windows 原生，不使用 Docker / WSL）
rem
rem  out/ 是自包含目录：编译后的 JS、静态资源、server.js 都在这里，
rem  目标机器只要装了 Node.js 就能双击本文件启动，不需要 npm install。
rem
rem  行为：检查 Node.js → 启动静态服务（端口 8080，被占用则顺延 8081、8082 …）
rem        → 服务就绪后自动打开浏览器；日志留在本窗口，Ctrl+C 停止。
rem  后端：/api 的代理目标写在本目录 api-target.txt（可选，留空即纯静态预览）。
rem  退出码：1 缺少 Node.js；2 缺少 server.js；3 缺少 index.html；4 服务异常退出。
rem ============================================================================
setlocal enabledelayedexpansion
chcp 65001 >nul
cd /d "%~dp0"
set "HERE=%~dp0"
set "EXIT_CODE=0"

echo.
echo === 艺数智策 · 前端服务启动 ===
echo 目录：%HERE%
echo.

where node >nul 2>nul
if errorlevel 1 (
  echo [错误] 未检测到 Node.js。请安装 Node.js 20 或更高版本，并确保 node 已加入 PATH。
  echo [error] Node.js not found. Install Node.js 20+ and make sure "node" is on PATH.
  echo         下载地址：https://nodejs.org/
  set "EXIT_CODE=1"
  goto :finish
)
for /f "delims=" %%v in ('node --version 2^>nul') do set "NODE_VERSION=%%v"
echo [环境] Node.js !NODE_VERSION!

if not exist "%HERE%server.js" (
  echo [错误] 未找到 server.js，请确认 out 目录完整（index.html、assets、server.js、start.bat）。
  echo [error] server.js not found next to this script.
  set "EXIT_CODE=2"
  goto :finish
)
if not exist "%HERE%index.html" (
  echo [错误] 未找到 index.html，请确认 out 目录完整（index.html、assets、server.js、start.bat）。
  echo [error] index.html not found next to this script.
  set "EXIT_CODE=3"
  goto :finish
)

echo [启动] 正在启动本地服务：默认端口 8080，被占用时自动顺延。
echo [提示] 服务就绪后会自动打开浏览器；停止服务请按 Ctrl+C。
echo.

node "%HERE%server.js"
set "NODE_EXIT=!ERRORLEVEL!"
if !NODE_EXIT! EQU 130 echo [提示] 已收到 Ctrl+C，服务停止。
if !NODE_EXIT! GEQ 1 if !NODE_EXIT! NEQ 130 (
  echo.
  echo [错误] 服务未正常退出（退出码 !NODE_EXIT!），原因见上面的日志。
  echo [error] The server exited with code !NODE_EXIT!. See the log above.
  set "EXIT_CODE=4"
)

:finish
echo.
echo 服务已结束（退出码 !EXIT_CODE!）。
pause
endlocal & exit /b %EXIT_CODE%
