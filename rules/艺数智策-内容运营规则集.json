{
  "name": "艺数智策·内容运营规则集",
  "version": "1.0",
  "description": "适用于艺术内容团队的自动标记、复盘提醒、负责人分配和状态治理规则。导入前请按团队实际平台名称调整 set_owner 规则中的负责人。",
  "status_convention": ["已发布", "未发布"],
  "rules": [
    {
      "name": "高表现内容进入复盘池",
      "priority": 900,
      "enabled": true,
      "trigger": "content.create",
      "logic": "all",
      "conditions": [
        {"field": "lifecycle", "operator": "eq", "value": "已发布"},
        {"field": "views", "operator": "gte", "value": 1000},
        {"field": "completion", "operator": "gte", "value": 60}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["已发布"]},
      "actions": [
        {"type": "add_tag", "value": "高表现待复盘"},
        {"type": "append_note", "value": "系统判定为高表现内容：建议复盘选题、开头和传播路径，并沉淀为可复用模板。"}
      ]
    },
    {
      "name": "高互动内容重点复盘",
      "priority": 880,
      "enabled": true,
      "trigger": "content.update",
      "logic": "any",
      "conditions": [
        {"field": "likes", "operator": "gte", "value": 300},
        {"field": "comments", "operator": "gte", "value": 80},
        {"field": "completion", "operator": "gte", "value": 70}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["已发布"]},
      "actions": [
        {"type": "add_tag", "value": "高互动"},
        {"type": "append_note", "value": "互动或看完表现达到重点复盘阈值，请记录观众问题和有效表达。"}
      ]
    },
    {
      "name": "低留存内容触发改进提醒",
      "priority": 820,
      "enabled": true,
      "trigger": "content.update",
      "logic": "all",
      "conditions": [
        {"field": "lifecycle", "operator": "eq", "value": "已发布"},
        {"field": "views", "operator": "gte", "value": 300},
        {"field": "completion", "operator": "lt", "value": 35}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["已发布"]},
      "actions": [
        {"type": "add_tag", "value": "低留存需优化"},
        {"type": "append_note", "value": "看完比例偏低：下次优先检查前3秒、信息密度、时长和结尾承接。"}
      ]
    },
    {
      "name": "高评论内容转为选题线索",
      "priority": 780,
      "enabled": true,
      "trigger": "content.import",
      "logic": "all",
      "conditions": [
        {"field": "comments", "operator": "gte", "value": 50},
        {"field": "lifecycle", "operator": "eq", "value": "已发布"}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["已发布"]},
      "actions": [
        {"type": "add_tag", "value": "评论选题线索"},
        {"type": "append_note", "value": "评论量较高：整理高频问题，评估为系列内容或下一轮选题。"}
      ]
    },
    {
      "name": "未发布内容补齐负责人",
      "priority": 700,
      "enabled": true,
      "trigger": "content.create",
      "logic": "all",
      "conditions": [
        {"field": "lifecycle", "operator": "eq", "value": "未发布"},
        {"field": "owner", "operator": "eq", "value": ""}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["未发布"]},
      "actions": [
        {"type": "add_tag", "value": "待分配负责人"},
        {"type": "append_note", "value": "未发布内容尚未分配负责人，请在排期前补齐负责人和计划时间。"}
      ]
    },
    {
      "name": "未发布内容统一治理",
      "priority": 650,
      "enabled": true,
      "trigger": "manual",
      "logic": "all",
      "conditions": [
        {"field": "lifecycle", "operator": "neq", "value": "已发布"}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": ["未发布"]},
      "actions": [
        {"type": "add_tag", "value": "未发布资产"},
        {"type": "append_note", "value": "请在周会中确认该内容的下一步：继续制作、排期发布或归档。"}
      ]
    },
    {
      "name": "内容导入字段完整性提醒",
      "priority": 500,
      "enabled": true,
      "trigger": "content.import",
      "logic": "any",
      "conditions": [
        {"field": "owner", "operator": "eq", "value": ""},
        {"field": "source", "operator": "eq", "value": ""},
        {"field": "platform", "operator": "eq", "value": ""}
      ],
      "scope": {"platforms": [], "categories": [], "statuses": []},
      "actions": [
        {"type": "add_tag", "value": "需补齐基础字段"},
        {"type": "append_note", "value": "导入记录缺少标题、平台或分类，请补齐后再纳入分析。"}
      ]
    }
  ]
}
