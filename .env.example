# Cloud/managed PostgreSQL connection string. Prefer TLS parameters supplied by
# your provider, for example sslmode=verify-full and a provider CA certificate.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?sslmode=require

# Generate once with a cryptographically secure password generator (32+ chars).
# Keep the value stable across restarts and private to the deployment.
APP_SECRET=
API_ADDR=:8080
API_PORT=8080
WEB_PORT=8081
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
DB_POOL_MAX=20
DB_POOL_MIN=2
REQUEST_TIMEOUT=15s

# Optional OpenAI-compatible endpoint. The key is always injected at runtime.
AI_BASE_URL=https://api.kunyou.asia/v1
AI_MODEL=qwen3.8-max
AI_API_KEY=
