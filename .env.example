# SQLite is the default. PostgreSQL can be used with a SQLAlchemy URL.
DATABASE_URL=sqlite:///./data/arts_smart.db
APP_SECRET=replace-this-for-a-shared-deployment
SEED_ON_START=true
MIN_SAMPLE_SIZE=5
RULE_FALLBACK=true
# Optional default model configuration. Prefer setting credentials in the UI
# only on a trusted, private deployment. Values are stored in the server DB.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
OCR_LANG=chi_sim+eng
