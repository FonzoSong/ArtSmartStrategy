# Local Docker PostgreSQL service. Use long random values with URL-safe characters.
POSTGRES_DB=arts_smart
POSTGRES_ADMIN_USER=arts_admin
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=arts_app
APP_DB_PASSWORD=
LOAD_EXAMPLE_DATA=true

# Generate once with a cryptographically secure generator (at least 32 chars).
# Keep stable across restarts; never commit the real value.
APP_SECRET=

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
# Timezone of the deployed team. It decides when a 正式演出 is considered to have
# started (auto 已演出) and how calendar dates are rendered by the database.
TZ=Asia/Shanghai
DB_POOL_MAX=20
DB_POOL_MIN=2
REQUEST_TIMEOUT=15s

# Optional OpenAI-compatible endpoint. The key is injected into the API only.
AI_BASE_URL=https://api.kunyou.asia/v1
AI_MODEL=qwen3.8-max
AI_API_KEY=

# For running the Go API outside Docker only:
# DATABASE_URL=postgresql://arts_app:URL_ENCODED_PASSWORD@localhost:5432/arts_smart?sslmode=disable
