# Local Windows PostgreSQL connection. Docker Compose overrides this with its database service.
DATABASE_URL=postgresql+psycopg://postgres:change-this@localhost:5432/arts_smart
# Replace manually for shared/production deployment. The application atomically
# creates a random secret and persists it in .env when this placeholder remains.
APP_SECRET=replace-this-for-a-shared-deployment
MIN_SAMPLE_SIZE=5
RULE_FALLBACK=true
POSTGRES_PASSWORD=change-this
POSTGRES_USER=arts_smart
POSTGRES_DB=arts_smart
SEED_DATA=false
# Optional OpenAI-compatible model configuration. Keep the key empty in files
# committed to source control. Configure AI_API_KEY in the local .env or UI.
AI_BASE_URL=https://api.kunyou.asia/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max
