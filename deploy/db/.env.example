# Bind only to the DB server's private interface. Firewall port 5432 to the API host.
DB_BIND_ADDRESS=10.10.0.10
DB_VOLUME_NAME=arts-smart-postgres-data

POSTGRES_DB=arts_smart
POSTGRES_USER=arts_admin
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
APP_DB_USER=arts_app
APP_DB_PASSWORD=replace-with-a-different-long-random-url-safe-value
LOAD_EXAMPLE_DATA=false
