# Use 0.0.0.0 behind a firewall/reverse proxy for remote users; use 127.0.0.1 locally.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80

# Reach the API server over its private address or VPN.
API_UPSTREAM=http://59.110.90.28:8080

# API_UPSTREAM is substituted into the Nginx config when the container starts, so
# after editing it recreate the container (and rebuild if the Nginx template
# changed). Compose reads this file from the directory that holds compose.yaml:
#   docker compose --env-file deploy/web/.env -f deploy/web/compose.yaml up --build -d --wait

# The API must allow every origin users reach this web container through
# (http://127.0.0.1, http://localhost, https://arts.example.com, ...): the browser
# sends Origin on each POST/PATCH/DELETE, and the API answers an unlisted origin
# with 403 跨域来源未获允许, which breaks login, first-time setup and any save.
# Register the origins in the API server's CORS_ALLOWED_ORIGINS instead of
# weakening that check.
