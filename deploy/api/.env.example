# Allow the Web server to reach this private interface. Firewall port 8080 to Web only.
API_BIND_ADDRESS=10.10.0.20
# Host port published for the API. Keep the port part of API_ADDR in step with it:
# the container healthcheck now follows API_ADDR instead of a hardcoded :8080.
API_PORT=8080
API_ADDR=:8080
# Keep the same timezone as the DB and the operations team.
TZ=Asia/Shanghai

# Use the DB private IP/VPN address and the same APP_DB_PASSWORD configured on DB server.
# URL-encode reserved characters in the username/password.
DATABASE_URL=postgresql://arts_app:replace-with-db-app-password@10.10.0.10:5432/arts_smart?sslmode=disable
APP_SECRET=replace-with-stable-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://arts.example.com
REQUEST_TIMEOUT=15s
DB_POOL_MAX=20
DB_POOL_MIN=2
AI_BASE_URL=https://api.kunyou.asia/v1
AI_MODEL=qwen3.8-max
AI_API_KEY=

# Optional. Only needed when the health endpoint is not reachable on the loopback
# host/port derived from API_ADDR (for example behind a TLS terminator).
# HEALTHCHECK_URL=https://api.internal.example.com/api/health/ready
